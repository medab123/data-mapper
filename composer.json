{
    "name": "medox/data-mapper",
    "description": "DataMapper - A reusable, framework-agnostic data mapping and transformation component for Laravel.",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Mohammed Elabidi",
            "email": "mohammed.elabidi123@gmail.com"
        }
    ],
    "require": {
        "php": "^8.3|^8.4",
        "illuminate/support": "^12.0|^13.0",
        "spatie/laravel-data": "^4.19"
    },
    "require-dev": {
        "orchestra/testbench": "^10.0|^11.0",
        "phpunit/phpunit": "^11.5.3|^12.0",
        "laravel/pint": "^1.24"
    },
    "autoload": {
        "psr-4": {
            "Medox\\DataMapper\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Medox\\DataMapper\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Medox\\DataMapper\\DataMapperServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "config": {
        "sort-packages": true,
        "preferred-install": "dist",
        "optimize-autoloader": true
    }
}
